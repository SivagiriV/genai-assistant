# FastAPI / RAG backend
GROQ_API_KEY=your_groq_key
PINECONE_API_KEY=your_pinecone_key
PINECONE_INDEX=support-assistant
PINECONE_NAMESPACE=kb
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
LLM_MODEL=llama-3.3-70b-versatile
VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
TOP_K=4
MIN_RELEVANCE=0.30
SHOW_SOURCES=true
SUPPORT_CONTACT=our support team

# API security / deployment
BO_API_TOKEN=generate-a-long-random-token
ALLOWED_ORIGINS=*
# On Render with a persistent disk, use:
# KB_DB=/var/data/kb.db
# KB_STORAGE=/var/data/storage
